# 构建出的容器用户必须能读取专用 SSH 目录并写入数据目录。
# Replace these values with: id -u / id -g
GPUMON_UID=1000
GPUMON_GID=1000

# 使用绝对路径，目录内放专用 config、known_hosts 和私钥；不要挂载个人 SSH 目录。
# Use an absolute path containing dedicated config, known_hosts, and private keys.
GPUMON_SSH_DIR=/absolute/path/to/gpumon-ssh

# 配置和 SQLite 数据保留在宿主文件系统；相对路径以 compose.yaml 所在目录为基准。
GPUMON_CONFIG_DIR=./config
GPUMON_DATA_DIR=./data

# Web 默认只暴露到宿主回环；团队访问应继续经过带认证的 HTTPS 反向代理。
GPUMON_WEB_BIND=127.0.0.1
GPUMON_WEB_PORT=8848

GPUMON_IMAGE=cluster-gpu-monitor:local
